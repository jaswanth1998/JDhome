rules_version = '2';

// Two very different users share this database:
//   1. The public website, which may only CREATE well-formed `inquiries`.
//      The n8n lead-alert automation signs in as the Firebase Auth email/password
//      user in isLeadBot() to read inquiries and mark them notified.
//   2. The admin panel (/admin), whose signed-in users must have an
//      `admins/{uid}` document. Admins own every business collection:
//      clients, invoices, invoiceFiles, estimates, serviceItems, settings,
//      counters, shared.
//      `admins` docs are created in the Firebase console or by
//      scripts/migrate/import-firestore.mjs — never from the browser.
//   3. Anyone holding a share link may GET one `shared/{token}` document
//      (the token is an unguessable uuid); listing is never allowed.
// Keep the inquiry field list in sync with src/lib/inquiries/schema.ts + submit.ts.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Create this user in Firebase console > Authentication > Users BEFORE
    // deploying, and turn off public sign-up (Authentication > Settings >
    // User actions) so nobody else can register this address.
    function isLeadBot() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email == 'n8n-leads-bot@jd-home-services-prod.firebaseapp.com';
    }

    function isShortString(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    function validDetails(d) {
      return d is map
        && d.keys().hasOnly(['garageIssue', 'propertyType', 'cameraCount', 'cameraFeatures'])
        && (!('garageIssue' in d) || isShortString(d.garageIssue, 1, 60))
        && (!('propertyType' in d) || isShortString(d.propertyType, 1, 60))
        && (!('cameraCount' in d) || isShortString(d.cameraCount, 1, 40))
        && (!('cameraFeatures' in d) || (d.cameraFeatures is list && d.cameraFeatures.size() <= 10));
    }

    // Ad click id + UTM tags captured on the landing page (src/lib/tracking/attribution.ts).
    function validAttribution(a) {
      return a is map
        && a.keys().hasOnly([
             'gclid', 'gbraid', 'wbraid', 'utm_source', 'utm_medium', 'utm_campaign',
             'utm_term', 'utm_content', 'landingPage'
           ])
        && (!('gclid' in a) || isShortString(a.gclid, 1, 200))
        && (!('gbraid' in a) || isShortString(a.gbraid, 1, 200))
        && (!('wbraid' in a) || isShortString(a.wbraid, 1, 200))
        && (!('utm_source' in a) || isShortString(a.utm_source, 1, 200))
        && (!('utm_medium' in a) || isShortString(a.utm_medium, 1, 200))
        && (!('utm_campaign' in a) || isShortString(a.utm_campaign, 1, 200))
        && (!('utm_term' in a) || isShortString(a.utm_term, 1, 200))
        && (!('utm_content' in a) || isShortString(a.utm_content, 1, 200))
        && (!('landingPage' in a) || isShortString(a.landingPage, 1, 200));
    }

    match /inquiries/{inquiryId} {
      allow create: if request.resource.data.keys().hasOnly([
            'service', 'serviceLabel', 'details', 'city', 'timing', 'message',
            'name', 'phone', 'email', 'preferredContact', 'page', 'status', 'createdAt',
            'attribution'
          ])
        && request.resource.data.keys().hasAll([
            'service', 'serviceLabel', 'city', 'timing', 'name', 'phone',
            'preferredContact', 'status', 'createdAt'
          ])
        && request.resource.data['service'] in [
            'garage-repair', 'garage-install', 'security-cameras', 'locksmith', 'car-lockout', 'other'
          ]
        && isShortString(request.resource.data.serviceLabel, 1, 60)
        && validDetails(request.resource.data.get('details', {}))
        && isShortString(request.resource.data.city, 1, 60)
        && isShortString(request.resource.data.timing, 1, 60)
        && isShortString(request.resource.data.get('message', ''), 0, 1500)
        && isShortString(request.resource.data.name, 2, 80)
        && isShortString(request.resource.data.phone, 7, 30)
        && isShortString(request.resource.data.get('email', ''), 0, 120)
        && request.resource.data.preferredContact in ['phone', 'text', 'email']
        && isShortString(request.resource.data.get('page', ''), 0, 200)
        && validAttribution(request.resource.data.get('attribution', {}))
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;

      allow read: if isLeadBot() || isAdmin();
      allow update: if isLeadBot()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'notifiedAt', 'telegramMessageId']);
      allow delete: if false;
    }

    // ----- Admin panel -----------------------------------------------------

    // A signed-in user may read only their own admins doc (that is how the app
    // learns whether it is an admin). Nobody may write admins from the browser.
    match /admins/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    match /clients/{clientId} {
      allow read, write: if isAdmin();
    }

    match /invoices/{invoiceId} {
      allow read, write: if isAdmin();
    }

    match /estimates/{estimateId} {
      allow read, write: if isAdmin();
    }

    // Uploaded third-party invoice PDFs (base64), one per invoice.
    match /invoiceFiles/{invoiceId} {
      allow read, write: if isAdmin();
    }

    match /serviceItems/{itemId} {
      allow read, write: if isAdmin();
    }

    // Single document: settings/document (editable PDF copy).
    match /settings/{settingId} {
      allow read, write: if isAdmin();
    }

    // Monthly sequence counters for INV-/EST- numbers (transactions only).
    match /counters/{counterId} {
      allow read, write: if isAdmin();
    }

    // Public share links. The document id IS the credential (an unguessable
    // uuid), so single-document GET is open while sharing is on; listing is
    // never allowed. Admins write these alongside the invoice/estimate.
    match /shared/{token} {
      allow get: if resource.data.share_enabled == true;
      allow list: if false;
      allow write: if isAdmin();
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
