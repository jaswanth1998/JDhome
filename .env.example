NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: direct Google Analytics 4 tag (e.g. G-XXXXXXXXXX). Leave EMPTY when GA4 is configured inside GTM, or pageviews double-count.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Optional: Google Search Console HTML-tag verification token (content value only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Optional: override the Google Tag Manager container set in theme.analytics.gtmId (default GTM-5Q937BVV).
NEXT_PUBLIC_GTM_ID=
